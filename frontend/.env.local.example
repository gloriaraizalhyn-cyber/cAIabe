# Client-side Google Maps JavaScript API key (Maps JS + should be
# referrer-restricted to this app's domain). Separate from the backend's
# GOOGLE_MAPS_API_KEY in supabase/.env.local.example, which is server-side.
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-javascript-api-key

# Supabase project the frontend talks to. The anon key is safe to expose
# client-side (it's paired with Row Level Security policies, not a secret).
# Default here points at the cloud project already used by
# mock-driver-simulator.js / queue_advance_cron.sql; swap for
# SUPABASE_URL / SUPABASE_ANON_KEY in supabase/.env.local instead if you
# stand up a local `supabase start` stack.
VITE_SUPABASE_URL=https://hprgaaynsucaguzlcndd.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Firebase web app config (Project settings -> General -> Your apps -> Web
# app), used only for Cloud Messaging (driver queue-turn push alerts).
# These values are meant to be public, same posture as the anon key above.
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id
# Cloud Messaging -> Web configuration -> Web Push certificates
VITE_FIREBASE_VAPID_KEY=your-vapid-key

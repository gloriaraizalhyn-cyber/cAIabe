# Client-side Google Maps JavaScript API key (Maps JS + should be
# referrer-restricted to this app's domain). Separate from the backend's
# GOOGLE_MAPS_API_KEY in supabase/.env.local.example, which is server-side.
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-javascript-api-key

# Supabase project URL and anon (public) key — used to call Edge Functions
# like route-search from the browser. The anon key is meant to be public;
# it's gated by this project's Row Level Security policies, not secrecy.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

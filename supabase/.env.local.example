# Copy this to .env.local and fill in real values.
# Used by: supabase functions serve --env-file .env.local

SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=your-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key

GOOGLE_MAPS_API_KEY=your-google-maps-api-key
GEMINI_API_KEY=your-gemini-api-key
# Full JSON contents of a Firebase service account key (Project settings ->
# Service accounts -> Generate new private key), pasted as-is on one line.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
# From your TextBee dashboard (textbee.dev) — turns an Android phone into
# the SMS gateway. TEXTBEE_DEVICE_ID is optional; omit it to use your most
# recently active device.
TEXTBEE_API_KEY=your-textbee-api-key
TEXTBEE_DEVICE_ID=your-textbee-device-id
